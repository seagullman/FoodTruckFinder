{
  "auth": {
    "plugins": {
      "awsCognitoAuthPlugin": {
        "UserAgent": "aws-amplify/cli",
        "Version": "1.0",
        "IdentityManager": {
            "Default": {
            }
        },
        "CognitoUserPool": {
          "Default": {
            "PoolId": "us-east-1_sCMpc3QSL",
            "AppClientId": "mi4krnv0lharhjfossahgk6sm",
            "Region": "us-east-1"
          }
        },
        "Auth": {
          "Default": {
            "authenticationFlowType": "USER_SRP_AUTH",
            "passwordProtectionSettings": {
                "passwordPolicyMinLength": 8,
                "requireUppercase": true,
                "requireNumbers": true,
                "requireSymbols": false
            }
          }
        }
      }
    }
  }
}
